#!/usr/bin/env bash
# My_Pie 방화벽 도구 (root로 돈다): SSH를 마구 두드리는 IP를 nftables로 막는다.
# 텔레그램 'IP 막기' 버튼이 sudo로 부른다. firewall-setup.sh가 /usr/local/sbin에 설치한다.
#   mypie-firewall block <IP>     막기 (그 IP가 보내는 건 전부 버린다. 집 안 IP는 못 막는다)
#   mypie-firewall unblock <IP>   풀기
#   mypie-firewall list           막은 IP 목록
#   mypie-firewall restore        목록대로 다시 막기 (재부팅 뒤 봇이 부른다)
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LIST=/etc/mypie/blocked-ips

parse() {  # 공인 IP면 "버전 IP"를 찍는다. 집 안·특수 IP나 IP가 아니면 실패 (집 안 IP를 막으면 내가 못 들어온다)
  python3 -I -c '
import ipaddress, sys
try:
    a = ipaddress.ip_address(sys.argv[1])
except ValueError:
    sys.exit(1)
if a.is_private or a.is_loopback or a.is_link_local or a.is_multicast or a.is_unspecified or a.is_reserved:
    sys.exit(1)
print(a.version, a.compressed)' "$1"
}

table() {  # 막는 표가 없으면 만든다 (다른 방화벽 설정은 건드리지 않는다)
  nft list table inet mypie >/dev/null 2>&1 && return 0
  nft -f - <<'EOF'
table inet mypie {
  set blocked4 { type ipv4_addr; }
  set blocked6 { type ipv6_addr; }
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr @blocked4 drop
    ip6 saddr @blocked6 drop
  }
}
EOF
}

need_ip() {
  if [ -z "${1:-}" ]; then echo "IP를 같이 적어 주세요"; exit 2; fi
  if ! parsed=$(parse "$1"); then echo "막을 수 없는 IP예요 (집 안 IP이거나 IP 모양이 아니에요): $1"; exit 2; fi
  read -r ver ip <<< "$parsed"
}

mkdir -p /etc/mypie
touch "$LIST"
case "${1:-}" in
  block)
    need_ip "${2:-}"
    table
    grep -qxF "$ip" "$LIST" || echo "$ip" >> "$LIST"
    nft add element inet mypie "blocked$ver" "{ $ip }"
    echo "$ip"
    ;;
  unblock)
    need_ip "${2:-}"
    grep -vxF "$ip" "$LIST" > "$LIST.tmp" || true
    mv "$LIST.tmp" "$LIST"
    nft delete element inet mypie "blocked$ver" "{ $ip }" 2>/dev/null || true
    echo "$ip"
    ;;
  list)
    cat "$LIST"
    ;;
  restore)
    nft delete table inet mypie 2>/dev/null || true
    table
    while read -r line; do
      [ -n "$line" ] || continue
      parsed=$(parse "$line") || continue
      read -r ver ip <<< "$parsed"
      nft add element inet mypie "blocked$ver" "{ $ip }"
    done < "$LIST"
    ;;
  *)
    echo "사용법: mypie-firewall block|unblock <IP> | list | restore"
    exit 2
    ;;
esac
